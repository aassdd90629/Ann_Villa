{
  "name": "ann-villa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "sync:ical": "node scripts/parse-ical.js",
    "prebuild": "node scripts/parse-ical.js",
    "build": "vite build",
    "preview": "vite preview",
    "d1:init:local": "wrangler d1 execute DB --local --file=./migrations/0000_init_schema.sql",
    "d1:seed:local": "wrangler d1 execute DB --local --file=./migrations/seed_data.sql",
    "d1:init:remote": "wrangler d1 execute ann-villa-db --remote --file=./migrations/0000_init_schema.sql",
    "d1:seed:remote": "wrangler d1 execute ann-villa-db --remote --file=./migrations/seed_data.sql",
    "pages:dev": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "sass": "^1.105.1",
    "vite": "^8.3.0",
    "wrangler": "^4.161.0"
  }
}
